generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String          @id @default(cuid())
  email               String?         @unique
  username            String          @unique
  passwordHash        String
  role                UserRole
  forcePasswordChange Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  isTestAccount       Boolean         @default(false)
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
}

model TeacherProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  subject         Subject
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  batches         Batch[]
  rewardCycles    RewardCycle[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  teacherStudents TeacherStudent[]
  tests           Test[]
}

model StudentProfile {
  id                String           @id @default(cuid())
  userId            String           @unique
  board             Board
  medium            Medium
  classLevel        String
  rollNo            String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lastHomeworkDate  DateTime?
  streakCount       Int              @default(0)
  batchNo           String?
  batchSerialNo     Int?
  isTestAccount     Boolean          @default(false)
  longId            String?          @unique
  overallSerial     Int?             @unique
  phone             String?
  shortId           String?          @unique
  subjects          Subject[]
  year              Int?
  batchLinks        BatchStudent[]
  badges            StudentBadge[]
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions       Submission[]
  teacherLinks      TeacherStudent[]
  directAssignments TestAssignment[] @relation("StudentAssignments")
}

model RegistrationRequest {
  id         String        @id @default(cuid())
  fullName   String
  subjects   Subject[]
  classLevel String
  medium     Medium
  phone      String
  year       Int
  status     RequestStatus @default(PENDING)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([phone, status])
}

model TeacherStudent {
  id        String         @id @default(cuid())
  teacherId String
  studentId String
  createdAt DateTime       @default(now())
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId])
}

model Batch {
  id            String              @id @default(cuid())
  name          String
  medium        Medium
  classLevel    String
  boardTarget   Board?
  teacherId     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  teacher       TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  rewardResults BatchRewardResult[]
  batchStudents BatchStudent[]
  assignments   TestAssignment[]

  @@index([teacherId, medium, classLevel])
}

model BatchStudent {
  id        String         @id @default(cuid())
  batchId   String
  studentId String
  createdAt DateTime       @default(now())
  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
}

model Test {
  id              String           @id @default(cuid())
  title           String
  subject         Subject
  teacherId       String
  boardTarget     Board?
  classLevel      String
  startTime       DateTime
  endTime         DateTime
  durationMinutes Int
  status          TestStatus       @default(DRAFT)
  creationMode    TestCreationMode @default(MANUAL)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  category        TestCategory     @default(WEEKLY_TEST)
  isDaily         Boolean          @default(false)
  questions       Question[]
  submissions     Submission[]
  teacher         TeacherProfile   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  assignments     TestAssignment[]

  @@index([teacherId, status, startTime, endTime])
}

model Question {
  id          String         @id @default(cuid())
  testId      String
  text        String
  chapter     String?
  concept     String?
  difficulty  Difficulty     @default(MEDIUM)
  marks       Int            @default(1)
  source      QuestionSource @default(MANUAL)
  explanation String?
  imageUrl    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  answers     Answer[]
  options     Option[]
  test        Test           @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model Option {
  id         String   @id @default(cuid())
  questionId String
  text       String
  imageUrl   String?
  isCorrect  Boolean  @default(false)
  answers    Answer[]
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuestionBankEntry {
  id          String       @id @default(cuid())
  text        String
  subject     Subject
  chapter     String?
  concept     String?
  difficulty  Difficulty   @default(MEDIUM)
  explanation String?
  imageUrl    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  options     BankOption[]

  @@index([subject, chapter])
}

model BankOption {
  id             String            @id @default(cuid())
  questionBankId String
  text           String
  imageUrl       String?
  isCorrect      Boolean           @default(false)
  question       QuestionBankEntry @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@index([questionBankId])
}

model TestAssignment {
  id        String          @id @default(cuid())
  testId    String
  studentId String?
  batchId   String?
  createdAt DateTime        @default(now())
  batch     Batch?          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student   StudentProfile? @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  test      Test            @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([studentId])
  @@index([batchId])
}

model Submission {
  id                String         @id @default(cuid())
  testId            String
  studentId         String
  startedAt         DateTime       @default(now())
  submittedAt       DateTime?
  scoreTotal        Float?
  maxScore          Float?
  aiAnalysisSummary String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  answers           Answer[]
  student           StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test              Test           @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, studentId])
}

model Answer {
  id               String     @id @default(cuid())
  submissionId     String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean    @default(false)
  marksObtained    Float      @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  question         Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   Option?    @relation(fields: [selectedOptionId], references: [id])
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

model RewardCycle {
  id          String              @id @default(cuid())
  teacherId   String
  subject     Subject
  periodStart DateTime
  periodEnd   DateTime
  status      RewardCycleStatus   @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  results     BatchRewardResult[]
  teacher     TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, subject, status])
}

model BatchRewardResult {
  id                     String      @id @default(cuid())
  rewardCycleId          String
  batchId                String
  averageNormalizedScore Float       @default(0)
  improvementScore       Float       @default(0)
  isWinner               Boolean     @default(false)
  isMostImproved         Boolean     @default(false)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  batch                  Batch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rewardCycle            RewardCycle @relation(fields: [rewardCycleId], references: [id], onDelete: Cascade)

  @@unique([rewardCycleId, batchId])
}

model StudentBadge {
  id          String           @id @default(cuid())
  studentId   String
  type        StudentBadgeType
  periodStart DateTime
  periodEnd   DateTime
  description String
  createdAt   DateTime         @default(now())
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, type, periodStart, periodEnd])
}

enum RequestStatus {
  PENDING
  APPROVED
  DECLINED
}

enum UserRole {
  SUPERADMIN
  TEACHER_ADMIN
  STUDENT
  INSTITUTE_ADMIN
}

enum Board {
  WEST_BENGAL
  ICSE
  CBSE
}

enum Medium {
  ENGLISH
  BENGALI
}

enum Subject {
  CHEMISTRY
  BIOLOGY
  MATHEMATICS
  PHYSICS
}

enum TestStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum TestCategory {
  HOMEWORK
  PRACTICE
  TEST
  UNIT_TEST
  WEEKLY_TEST
  MONTHLY_TEST
}

enum TestCreationMode {
  MANUAL
  AI
}

enum QuestionSource {
  MANUAL
  AI
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RewardCycleStatus {
  ACTIVE
  COMPLETED
}

enum StudentBadgeType {
  TOP_IMPROVER
  CONSISTENCY_STAR
  SUBJECT_STAR
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Enable IIS handler for node -->
    <handlers>
      <add name="iisnode" path="dist/src/server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Configure Node.js app -->
    <iisnode
      nodeProcessCommandLine="node dist/src/server.js"
      loggingEnabled="true"
      logDirectory="..\..\LogFiles\nodejs"
      debuggingEnabled="false"
      devErrorsEnabled="false"
    />

    <!-- URL rewriting rules -->
    <rewrite>
      <rules>
        <!-- Don't interfere with requests to node.js -->
        <rule name="NodeInspector" patternSyntax="ECMAScript" stopProcessing="true">
          <match url="^dist/src/server.js" />
        </rule>

        <!-- Route all other requests to node.js -->
        <rule name="StaticContent">
          <action type="Rewrite" url="dist/src/server.js" />
        </rule>

        <!-- Prevent directory listing -->
        <rule name="DirectoryBrowsing" stopProcessing="true">
          <match url="^.*$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="Response" statusCode="403" statusReason="Forbidden: Directory access is not allowed." statusDescription="403" />
        </rule>
      </rules>
    </rewrite>

    <!-- WebSocket support -->
    <webSocket enabled="true" />

    <!-- Custom error pages -->
    <httpErrors errorMode="Detailed" />
  </system.webServer>

  <!-- Application configuration -->
  <appSettings>
    <add key="NODE_ENV" value="production" />
  </appSettings>
</configuration>
